# -----------------------------------------------------------------------------
# Database (PostgreSQL + TimescaleDB)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=network_security
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/network_security

# -----------------------------------------------------------------------------
# Backend API & WebSocket Server
# -----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=info,backend=debug,capture_engine=debug
JWT_SECRET=default_super_secret_jwt_key_32_bytes_long_change_in_production
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7
CORS_ALLOWED_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Capture Engine Settings
# -----------------------------------------------------------------------------
CAPTURE_INTERFACE=eth0
CAPTURE_PROMISCUOUS=true
SIMULATION_MODE=true
SIMULATION_PACKETS_PER_SEC=1000

# -----------------------------------------------------------------------------
# Alerting & Notification Channels
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test_user
SMTP_PASSWORD=test_password
SMTP_FROM_EMAIL=alerts@secnet.local

TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_DEFAULT_CHAT_ID=-1001234567890

WEBHOOK_DEFAULT_URL=https://alerts.example.com/webhook
ALERT_DEDUPLICATION_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# Distributed Cache & Message Broker (Optional, falls back to in-memory)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
AUTO_BLOCK_CRITICAL_IPS=true
